@@ -22,6 +22,8 @@
 #if BUILDFLAG(IS_MAC)
   // Isolated world ID for AppleScript.
   ISOLATED_WORLD_ID_APPLESCRIPT,
+
+  ISOLATED_WORLD_ID_ARDIA_PAGE,
 #endif  // BUILDFLAG(IS_MAC)
 
