+void AutoplayPolicy::ArdiaSetFrameBlocked(LocalFrame& frame,
+                                          bool blocked,
+                                          bool pause_unasked) {
+  ArdiaFrameAutoplay::From(frame).blocked = blocked;
+  Document* document = frame.GetDocument();
+  if (!blocked || !pause_unasked || !document ||
+      ArdiaDocumentAsked(*document)) {
+    return;
+  }
+  ArdiaDocumentAutoplay* state = ArdiaDocumentAutoplay::Find(*document);
+  if (!state) {
+    return;
+  }
+  HeapVector<Member<HTMLMediaElement>> playing;
+  for (HTMLMediaElement* media : state->media) {
+    if (media && !media->paused() && &media->GetDocument() == document) {
+      playing.push_back(media);
+    }
+  }
+  HeapVector<Member<ArdiaAutoplayClient>> clients;
+  for (ArdiaAutoplayClient* client : state->clients) {
+    if (client) {
+      clients.push_back(client);
+    }
+  }
+  for (HTMLMediaElement* media : playing) {
+    media->pause();
+  }
+  for (ArdiaAutoplayClient* client : clients) {
+    client->ArdiaAutoplayRefused();
+  }
+}
