{
  "manifest_version": 3,
  "name": "Ardia Crawler",
  "version": "2026.11.18.2",
  "version_name": "2026-11-18.2",
  "description": "Blocks analytics and tracking requests and labels requests in crawler profiles.",
  "key": "",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      }
    ]
  }
}
