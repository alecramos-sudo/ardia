{
  "rulesVersion": "2026-11-18.2",
  "vendors": [
    {
      "vendor": "selftest",
      "what": "The app loads this host in a hidden tab; ERR_BLOCKED_BY_CLIENT proves the ruleset is in force",
      "rules": [
        {
          "requestDomains": ["ardia-crawler-selftest.invalid"],
          "resourceTypes": ["main_frame"],
          "fixtures": ["https://ardia-crawler-selftest.invalid/", "http://ardia-crawler-selftest.invalid/probe?run=1"]
        }
      ]
    },
    {
