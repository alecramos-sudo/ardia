      "rules": [
        {
          "requestDomains": [
            "google-analytics.com",
            "analytics.google.com",
            "googletagmanager.com",
            "doubleclick.net",
            "googleadservices.com",
            "googlesyndication.com",
            "googletagservices.com",
            "adservice.google.com"
          ],
          "fixtures": [
            "https://www.google-analytics.com/g/collect?v=2&tid=G-ABC123&cid=1.2&en=page_view",
            "https://region1.google-analytics.com/g/collect?v=2&tid=G-ABC123&en=scroll",
            "https://www.google-analytics.com/analytics.js",
            "https://analytics.google.com/g/collect?v=2&tid=G-ABC123",
            "https://www.googletagmanager.com/gtag/js?id=G-ABC123",
            "https://www.googletagmanager.com/gtm.js?id=GTM-ABC123",
            "https://www.googletagmanager.com/ns.html?id=GTM-ABC123",
            "https://stats.g.doubleclick.net/g/collect?v=2&tid=G-ABC123",
            "https://td.doubleclick.net/td/rul/123456789?random=1",
            "https://googleads.g.doubleclick.net/pagead/viewthroughconversion/123456789/?random=1",
            "https://ad.doubleclick.net/activity;src=123;type=sales;cat=x",
            "https://www.googleadservices.com/pagead/conversion_async.js",
            "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js",
            "https://www.googletagservices.com/tag/js/gpt.js",
            "https://adservice.google.com/ddm/fls/z/src=123"
          ]
        },
        {
          "urlFilter": "||google.com/ccm/collect^",
          "fixtures": ["https://www.google.com/ccm/collect?en=page_view&tid=AW-123456789&dl=https%3A%2F%2Fshop.example.com%2F"]
        },
        {
          "urlFilter": "||google.com/pagead/",
          "fixtures": ["https://www.google.com/pagead/1p-user-list/123456789/?random=1&cv=11"]
        },
        {
          "urlFilter": "||google.com/ads/ga-audiences^",
          "fixtures": ["https://www.google.com/ads/ga-audiences?v=1&t=sr&tid=G-ABC123&cid=1.2"]
        },
        {
          "urlFilter": "||google.com/rmkt/collect/",
          "fixtures": ["https://www.google.com/rmkt/collect/123456789/?random=1"]
        },
        {
          "regexFilter": "^https?://www\\.google\\.(?:[a-z]{2,3}|co\\.[a-z]{2}|com\\.[a-z]{2})/(?:ccm/collect|pagead/|ads/ga-audiences|rmkt/collect/)",
          "fixtures": [
            "https://www.google.co.uk/pagead/1p-user-list/123456789/?random=1",
            "https://www.google.de/ads/ga-audiences?v=1&t=sr&tid=G-ABC123",
            "https://www.google.com.au/ccm/collect?en=page_view&tid=AW-1"
          ]
        },
        {
          "urlFilter": "/g/collect^",
          "fixtures": [
            "https://shop.example.com/g/collect?v=2&tid=G-ABC123&en=page_view",
            "https://sgtm.example.com/g/collect?v=2&tid=G-ABC123&en=add_to_cart"
          ]
        },
        {
          "urlFilter": "/j/collect^",
          "fixtures": ["https://sgtm.example.com/j/collect?v=1&tid=UA-123-1&cid=1"]
        },
        {
          "urlFilter": "/mp/collect^",
          "fixtures": ["https://sgtm.example.com/mp/collect?measurement_id=G-ABC123&api_secret=x"]
        },
        {
          "urlFilter": "collect?v=2&tid=G-",
          "fixtures": ["https://data.example.com/metrics/collect?v=2&tid=G-ABC123&cid=1.2&en=page_view"]
        },
        {
          "regexFilter": "[?&]tid=G-[0-9a-z]+&(?:[^#]*&)?v=2(?:&|$)",
          "fixtures": ["https://data.example.com/x/collect?tid=G-ABC123&cid=1.2&v=2&en=page_view"]
        },
        {
          "urlFilter": "/gtm.js?id=GTM-",
          "fixtures": [
            "https://shop.example.com/gtm.js?id=GTM-ABC123",
            "https://sgtm.example.com/metrics/gtm.js?id=GTM-ABC123&l=dataLayer"
          ]
        },
        {
          "urlFilter": "/gtag/js?id=",
          "fixtures": ["https://sgtm.example.com/gtag/js?id=G-ABC123"]
        },
        {
          "urlFilter": "/gtag/destination?id=",
          "fixtures": ["https://sgtm.example.com/gtag/destination?id=AW-123456789&l=dataLayer"]
        }
      ]
    },
